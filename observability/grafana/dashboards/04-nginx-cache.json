{
  "uid": "wp-nginx-cache",
  "title": "04 — Nginx + FastCGI Cache",
  "description": "Nginx connections, request rate, cache HIT/MISS/BYPASS ratio. The most dramatic slide: 95%+ HIT rate at Level 2.",
  "tags": ["nginx", "cache"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-10m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Connections",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 500, "color": "yellow" }, { "value": 900, "color": "red" }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "nginx_connections_active", "legendFormat": "Active" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Accepted Connections / sec",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "cps" } },
      "targets": [{ "datasource": "Prometheus", "expr": "rate(nginx_connections_accepted_total[30s])", "legendFormat": "conn/s" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests / sec",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "datasource": "Prometheus", "expr": "rate(nginx_http_requests_total[30s])", "legendFormat": "RPS" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Waiting Connections",
      "description": "keepalive / idle — high values mean clients are slow, not the server",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "datasource": "Prometheus", "expr": "nginx_connections_waiting", "legendFormat": "Waiting" }]
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Nginx Request Rate Distribution",
      "description": "Shows breakdown by HTTP status codes",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "options": { "pieType": "donut", "displayLabels": ["name", "percent"] },
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" }}] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" }}] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" }}] }
        ]
      },
      "targets": [
        { "datasource": "Prometheus", "expr": "sum(increase(nginx_http_requests_total{status=~\"2..\"}[5m]))", "legendFormat": "2xx" },
        { "datasource": "Prometheus", "expr": "sum(increase(nginx_http_requests_total{status=~\"4..\"}[5m]))", "legendFormat": "4xx" },
        { "datasource": "Prometheus", "expr": "sum(increase(nginx_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Request Rate by Status Code",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "datasource": "Prometheus", "expr": "sum(rate(nginx_http_requests_total{status=~\"2..\"}[30s]))", "legendFormat": "2xx (success)" },
        { "datasource": "Prometheus", "expr": "sum(rate(nginx_http_requests_total{status=~\"3..\"}[30s]))", "legendFormat": "3xx (redirect)" },
        { "datasource": "Prometheus", "expr": "sum(rate(nginx_http_requests_total{status=~\"4..\"}[30s]))", "legendFormat": "4xx (client error)" },
        { "datasource": "Prometheus", "expr": "sum(rate(nginx_http_requests_total{status=~\"5..\"}[30s]))", "legendFormat": "5xx (server error — 502/504)" }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Request Volume & Success Rate",
      "description": "Tracks total requests and 2xx success rate over time",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "datasource": "Prometheus", "expr": "sum(rate(nginx_http_requests_total[1m]))", "legendFormat": "RPS" },
        { "datasource": "Prometheus", "expr": "sum(rate(nginx_http_requests_total{status=~\"2..\"}[1m]))", "legendFormat": "2xx RPS" }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "PHP-FPM Offload — Requests NOT hitting PHP",
      "description": "Every request served from cache = a PHP execution saved. This is the money slide.",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "datasource": "Prometheus", "expr": "sum(rate(nginx_http_requests_total[30s]))", "legendFormat": "Total RPS (Nginx)" },
        { "datasource": "Prometheus", "expr": "rate(phpfpm_accepted_connections[30s])", "legendFormat": "RPS hitting PHP-FPM" }
      ]
    }
  ],
  "schemaVersion": 39
}
