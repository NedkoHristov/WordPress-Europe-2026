{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    { "id": "title", "type": "text", "x": 40, "y": 14, "width": 820, "height": 28,
      "text": "Redis Object Cache — Intercepting WordPress DB Calls", "fontSize": 19, "fontFamily": 1, "textAlign": "center", "strokeColor": "#1971c2", "fontStyle": 1 },

    { "id": "box-wp", "type": "rectangle", "x": 40, "y": 60, "width": 130, "height": 200,
      "strokeColor": "#1971c2", "backgroundColor": "#d0ebff", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3} },
    { "id": "lbl-wp-title", "type": "text", "x": 46, "y": 68, "width": 118, "height": 20,
      "text": "WordPress", "fontSize": 14, "fontFamily": 1, "textAlign": "center", "fontStyle": 1 },
    { "id": "lbl-wp-desc", "type": "text", "x": 46, "y": 90, "width": 118, "height": 160,
      "text": "Page request:\n\n300+ DB calls\nper page\n\nwp-settings.php\nincludes 100+\nfiles alone", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },

    { "id": "arr-wp-redis", "type": "arrow", "x": 172, "y": 100, "width": 78, "height": 0,
      "strokeColor": "#495057", "roughness": 1, "strokeWidth": 2, "startArrowhead": null, "endArrowhead": "arrow" },
    { "id": "lbl-wp-redis", "type": "text", "x": 178, "y": 84, "width": 66, "height": 14,
      "text": "lookup", "fontSize": 11, "fontFamily": 2, "strokeColor": "#495057", "textAlign": "center" },

    { "id": "box-redis", "type": "rectangle", "x": 252, "y": 60, "width": 200, "height": 200,
      "strokeColor": "#c92a2a", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3} },
    { "id": "lbl-redis-title", "type": "text", "x": 258, "y": 68, "width": 188, "height": 20,
      "text": "🔴 Redis (Object Cache)", "fontSize": 14, "fontFamily": 1, "textAlign": "center", "fontStyle": 1 },
    { "id": "lbl-redis-stats", "type": "text", "x": 258, "y": 94, "width": 188, "height": 60,
      "text": "46,000 keys · 14.5 MB\n6,000 ops/s at peak\n82% hit rate after warmup", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },

    { "id": "lbl-hit-title", "type": "text", "x": 258, "y": 160, "width": 188, "height": 18,
      "text": "HIT examples (0.1ms each):", "fontSize": 11, "fontFamily": 2, "strokeColor": "#2f9e44" },
    { "id": "lbl-hits", "type": "text", "x": 258, "y": 180, "width": 188, "height": 72,
      "text": "wp_get_option('siteurl')\nwp_get_option('blogname')\nWP_Query (recent posts)\nget_post_meta(id,'_price')", "fontSize": 11, "fontFamily": 2, "strokeColor": "#2f9e44" },

    { "id": "arr-hit-back", "type": "arrow", "x": 250, "y": 140, "width": -78, "height": 0,
      "strokeColor": "#2f9e44", "roughness": 1, "strokeWidth": 2, "startArrowhead": null, "endArrowhead": "arrow" },
    { "id": "lbl-hit-back", "type": "text", "x": 175, "y": 120, "width": 74, "height": 18,
      "text": "✅ HIT\n0.1 ms", "fontSize": 11, "fontFamily": 2, "strokeColor": "#2f9e44", "textAlign": "center" },

    { "id": "arr-redis-mysql", "type": "arrow", "x": 454, "y": 160, "width": 76, "height": 0,
      "strokeColor": "#c92a2a", "roughness": 1, "strokeWidth": 2, "startArrowhead": null, "endArrowhead": "arrow" },
    { "id": "lbl-miss", "type": "text", "x": 460, "y": 142, "width": 70, "height": 18,
      "text": "MISS\n(first time)", "fontSize": 11, "fontFamily": 2, "strokeColor": "#c92a2a", "textAlign": "center" },

    { "id": "box-mysql", "type": "rectangle", "x": 532, "y": 120, "width": 150, "height": 80,
      "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3} },
    { "id": "lbl-mysql-title", "type": "text", "x": 538, "y": 130, "width": 138, "height": 20,
      "text": "🗄️ MySQL", "fontSize": 14, "fontFamily": 1, "textAlign": "center", "fontStyle": 1 },
    { "id": "lbl-mysql-desc", "type": "text", "x": 538, "y": 154, "width": 138, "height": 38,
      "text": "4–8 ms per query\nresult → cached", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },

    { "id": "arr-mysql-back", "type": "arrow", "x": 530, "y": 188, "width": -76, "height": -20,
      "strokeColor": "#2f9e44", "roughness": 1, "strokeWidth": 1, "strokeStyle": "dashed", "startArrowhead": null, "endArrowhead": "arrow" },
    { "id": "lbl-mysql-cache", "type": "text", "x": 460, "y": 196, "width": 70, "height": 18,
      "text": "store in\nRedis", "fontSize": 11, "fontFamily": 2, "strokeColor": "#2f9e44", "textAlign": "center" },

    { "id": "divider", "type": "line", "x": 40, "y": 282, "width": 680, "height": 0,
      "strokeColor": "#ced4da", "roughness": 0, "strokeStyle": "dashed" },

    { "id": "lbl-before", "type": "text", "x": 40, "y": 296, "width": 320, "height": 18,
      "text": "Without Redis:  300+ MySQL queries/request @ 4-8ms each", "fontSize": 13, "fontFamily": 1, "strokeColor": "#c92a2a" },
    { "id": "lbl-after", "type": "text", "x": 40, "y": 318, "width": 440, "height": 18,
      "text": "With Redis (82% hit rate):  ~54 MySQL queries/request — 82% answered from RAM in 0.1ms", "fontSize": 13, "fontFamily": 1, "strokeColor": "#2f9e44" }
  ],
  "appState": { "viewBackgroundColor": "#ffffff" }
}
