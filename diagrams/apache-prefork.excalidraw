{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [

    { "id": "title", "type": "text", "x": 40, "y": 16, "width": 880, "height": 30,
      "text": "Apache Prefork — 1 OS Process Per Connection", "fontSize": 20, "fontFamily": 1, "textAlign": "center", "strokeColor": "#1971c2", "fontStyle": 1 },

    { "id": "browser", "type": "rectangle", "x": 40, "y": 64, "width": 110, "height": 44,
      "strokeColor": "#1971c2", "backgroundColor": "#d0ebff", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3} },
    { "id": "lbl-browser", "type": "text", "x": 46, "y": 74, "width": 98, "height": 24,
      "text": "🌐 Browser", "fontSize": 15, "fontFamily": 1, "textAlign": "center" },

    { "id": "arr-req", "type": "arrow", "x": 152, "y": 86, "width": 78, "height": 0,
      "strokeColor": "#1971c2", "roughness": 1, "strokeWidth": 2,
      "startArrowhead": null, "endArrowhead": "arrow" },
    { "id": "lbl-req", "type": "text", "x": 158, "y": 70, "width": 66, "height": 14,
      "text": "request", "fontSize": 11, "fontFamily": 2, "strokeColor": "#1971c2", "textAlign": "center" },

    { "id": "apache", "type": "rectangle", "x": 232, "y": 56, "width": 130, "height": 60,
      "strokeColor": "#e03131", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3} },
    { "id": "lbl-apache", "type": "text", "x": 238, "y": 66, "width": 118, "height": 40,
      "text": "Apache\nforks worker ↓", "fontSize": 14, "fontFamily": 1, "textAlign": "center" },

    { "id": "arr-fork", "type": "arrow", "x": 297, "y": 118, "width": 0, "height": 42,
      "strokeColor": "#e03131", "roughness": 1, "strokeWidth": 2,
      "startArrowhead": null, "endArrowhead": "arrow" },
    { "id": "lbl-fork", "type": "text", "x": 304, "y": 126, "width": 60, "height": 14,
      "text": "fork()", "fontSize": 11, "fontFamily": 2, "strokeColor": "#e03131" },

    { "id": "worker", "type": "rectangle", "x": 200, "y": 162, "width": 194, "height": 80,
      "strokeColor": "#f08c00", "backgroundColor": "#fff3bf", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3} },
    { "id": "lbl-worker", "type": "text", "x": 206, "y": 170, "width": 182, "height": 64,
      "text": "Worker Process\nloads PHP + WordPress\n~32 MB RAM\n300+ DB queries", "fontSize": 13, "fontFamily": 1, "textAlign": "center" },

    { "id": "arr-worker-db", "type": "arrow", "x": 396, "y": 202, "width": 74, "height": 0,
      "strokeColor": "#f08c00", "roughness": 1, "strokeWidth": 2,
      "startArrowhead": null, "endArrowhead": "arrow" },
    { "id": "lbl-worker-db", "type": "text", "x": 402, "y": 186, "width": 62, "height": 14,
      "text": "queries", "fontSize": 11, "fontFamily": 2, "strokeColor": "#f08c00", "textAlign": "center" },

    { "id": "db", "type": "rectangle", "x": 472, "y": 170, "width": 110, "height": 64,
      "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3} },
    { "id": "lbl-db", "type": "text", "x": 478, "y": 186, "width": 98, "height": 32,
      "text": "🗄️ MySQL\n300+ queries", "fontSize": 13, "fontFamily": 1, "textAlign": "center" },

    { "id": "arr-resp", "type": "arrow", "x": 200, "y": 210, "width": -48, "height": 0,
      "strokeColor": "#2f9e44", "roughness": 1, "strokeWidth": 2,
      "startArrowhead": null, "endArrowhead": "arrow" },
    { "id": "lbl-resp", "type": "text", "x": 152, "y": 214, "width": 48, "height": 14,
      "text": "response", "fontSize": 11, "fontFamily": 2, "strokeColor": "#2f9e44", "textAlign": "center" },

    { "id": "idle", "type": "rectangle", "x": 200, "y": 262, "width": 194, "height": 48,
      "strokeColor": "#c92a2a", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3} },
    { "id": "lbl-idle", "type": "text", "x": 206, "y": 272, "width": 182, "height": 28,
      "text": "⚠️ IDLE — waiting for next request\nholds 32 MB RAM", "fontSize": 12, "fontFamily": 1, "textAlign": "center", "strokeColor": "#c92a2a" },

    { "id": "divider", "type": "line", "x": 620, "y": 56, "width": 0, "height": 260,
      "strokeColor": "#ced4da", "roughness": 0, "strokeStyle": "dashed" },

    { "id": "lbl-problem", "type": "text", "x": 636, "y": 56, "width": 280, "height": 24,
      "text": "THE PROBLEM", "fontSize": 14, "fontFamily": 1, "strokeColor": "#c92a2a", "fontStyle": 1 },

    { "id": "p1", "type": "text", "x": 636, "y": 86, "width": 280, "height": 20,
      "text": "💻  2 GB RAM on VPS", "fontSize": 13, "fontFamily": 1 },
    { "id": "p2", "type": "text", "x": 636, "y": 112, "width": 280, "height": 20,
      "text": "🔧  OS + DB + Redis = ~512 MB overhead", "fontSize": 13, "fontFamily": 1 },
    { "id": "p3", "type": "text", "x": 636, "y": 138, "width": 280, "height": 20,
      "text": "📦  32 MB per idle WordPress worker", "fontSize": 13, "fontFamily": 1 },
    { "id": "p4", "type": "text", "x": 636, "y": 164, "width": 280, "height": 24,
      "text": "⚡  (2048 − 512) ÷ 32 = 47 workers max", "fontSize": 14, "fontFamily": 1, "strokeColor": "#e03131", "fontStyle": 1 },

    { "id": "box-w1", "type": "rectangle", "x": 636, "y": 200, "width": 52, "height": 26,
      "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3} },
    { "id": "lbl-w1", "type": "text", "x": 640, "y": 206, "width": 44, "height": 14,
      "text": "W #1", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },
    { "id": "box-w2", "type": "rectangle", "x": 694, "y": 200, "width": 52, "height": 26,
      "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3} },
    { "id": "lbl-w2", "type": "text", "x": 698, "y": 206, "width": 44, "height": 14,
      "text": "W #2", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },
    { "id": "box-w3", "type": "rectangle", "x": 752, "y": 200, "width": 52, "height": 26,
      "strokeColor": "#2f9e44", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3} },
    { "id": "lbl-w3", "type": "text", "x": 756, "y": 206, "width": 44, "height": 14,
      "text": "W #3", "fontSize": 12, "fontFamily": 1, "textAlign": "center" },
    { "id": "box-wdot", "type": "text", "x": 810, "y": 200, "width": 80, "height": 26,
      "text": "…  W #47", "fontSize": 12, "fontFamily": 1 },

    { "id": "lbl-idle2", "type": "text", "x": 636, "y": 234, "width": 280, "height": 18,
      "text": "↑ all 47 workers IDLE = 1.5 GB RAM consumed", "fontSize": 12, "fontFamily": 1, "strokeColor": "#c92a2a" },

    { "id": "box-w48", "type": "rectangle", "x": 636, "y": 262, "width": 260, "height": 26,
