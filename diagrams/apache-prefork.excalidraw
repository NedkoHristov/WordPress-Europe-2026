    { "id": "lbl-w48", "type": "text", "x": 641, "y": 268, "width": 250, "height": 14,
      "text": "Browser #48 → queued  ⚠️", "fontSize": 12, "fontFamily": 1, "textAlign": "center", "strokeColor": "#c92a2a" },
    { "id": "box-w200", "type": "rectangle", "x": 636, "y": 294, "width": 260, "height": 26,
      "strokeColor": "#c92a2a", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3} },
    { "id": "lbl-w200", "type": "text", "x": 641, "y": 300, "width": 250, "height": 14,
