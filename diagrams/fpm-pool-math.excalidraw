{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "id": "lbl-title", "type": "text", "x": 40, "y": 20, "width": 700, "height": 36,
      "text": "PHP-FPM Pool Math — pm.max_children", "fontSize": 22, "fontFamily": 1
    },
    {
      "id": "lbl-formula", "type": "text", "x": 40, "y": 70, "width": 700, "height": 30,
      "text": "pm.max_children  =  available_RAM  ÷  avg_worker_size", "fontSize": 20, "fontFamily": 1, "strokeColor": "#7950f2"
    },
    {
      "id": "box-vps", "type": "rectangle", "x": 40, "y": 120, "width": 700, "height": 200,
      "strokeColor": "#333", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "roughness": 1, "roundness": {"type": 3}
    },
    {
      "id": "lbl-total", "type": "text", "x": 60, "y": 140, "width": 200, "height": 20,
      "text": "Total VPS RAM: 2048 MB", "fontSize": 14, "fontFamily": 1
    },
    {
      "id": "box-os", "type": "rectangle", "x": 60, "y": 170, "width": 100, "height": 120,
      "strokeColor": "#868e96", "backgroundColor": "#dee2e6", "fillStyle": "solid", "roughness": 1
    },
    {
      "id": "lbl-os", "type": "text", "x": 75, "y": 223, "width": 70, "height": 30, "text": "OS\n~200MB", "fontSize": 12, "fontFamily": 1 },
    {
      "id": "box-mysql", "type": "rectangle", "x": 175, "y": 170, "width": 130, "height": 120,
      "strokeColor": "#e67700", "backgroundColor": "#fff3bf", "fillStyle": "solid", "roughness": 1
    },
    {
      "id": "lbl-mysql", "type": "text", "x": 186, "y": 210, "width": 108, "height": 40, "text": "MariaDB\nbuffer_pool\n512 MB", "fontSize": 12, "fontFamily": 1 },
    {
      "id": "box-redis", "type": "rectangle", "x": 320, "y": 170, "width": 90, "height": 120,
      "strokeColor": "#c92a2a", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "roughness": 1
    },
    {
      "id": "lbl-redis", "type": "text", "x": 330, "y": 218, "width": 70, "height": 30, "text": "Redis\n128 MB", "fontSize": 12, "fontFamily": 1 },
    {
      "id": "box-fpm", "type": "rectangle", "x": 425, "y": 170, "width": 290, "height": 120,
      "strokeColor": "#7950f2", "backgroundColor": "#f3d9fa", "fillStyle": "solid", "roughness": 1
    },
    {
      "id": "lbl-fpm-avail", "type": "text", "x": 435, "y": 195, "width": 270, "height": 60,
      "text": "Available for PHP-FPM workers\n~768 MB\n\n768 ÷ 40 MB/worker = 19 workers\n→ pm.max_children = 20", "fontSize": 12, "fontFamily": 1
    },
    {
      "id": "lbl-measure", "type": "text", "x": 40, "y": 340, "width": 700, "height": 40,
      "text": "Measure actual worker size:  docker stats $(docker compose ps -q wordpress-fpm) | cat\nOr inside container:  ps aux --no-headers -o rss,comm | awk '/php-fpm/{sum+=$1} END{print sum/NR/1024 \" MB avg\"}'", "fontSize": 12, "fontFamily": 1, "strokeColor": "#555"
    }
  ],
  "appState": { "viewBackgroundColor": "#ffffff" }
}
