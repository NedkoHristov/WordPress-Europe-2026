# Copy to .env and adjust as needed
# docker compose reads this automatically

# WordPress port on host
WP_PORT=8080

# Nginx config to use (swap for each level)
# Level 1: nginx.conf (no cache)
# Level 2: nginx-cache.conf (FastCGI page cache)
NGINX_CONF=nginx.conf

# PHP config
PHP_INI=php-tuned.ini
FPM_CONF=www.conf

# MariaDB config
# Level 0: 00-baseline.cnf
# Level 2: 10-tuned.cnf
MARIADB_CONFIG=00-baseline.cnf
